# Copy to .env. The key is read from here or from the environment; it is never printed or logged.
ANTHROPIC_API_KEY=

# Which model writes the SQL. anthropic (default) or openai (any OpenAI-compatible endpoint).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Only for LLM_PROVIDER=openai. Examples (check each provider's model names and limits):
#   Ollama, local and free:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5-coder:14b  (no key)
#   Gemini free tier:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   OpenRouter free models:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=qwen/qwen3-coder:free
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# auto: multilingual-e5 embeddings when the "embed" extra is installed, else BM25 only. off: always BM25 only.
EMBED=auto

# Database to ask about and evaluate (a BIRD dev db_id).
DB_ID=financial

# Optional: where data/, the BIRD download and the memory store live.
# DATA_DIR=data
# MEMORY_DB=data/memory.db
